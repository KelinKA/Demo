#include <iostream>
#include <cmath>

using namespace std;

double function(double x)
{
return x - 1/(3 + sin(3.6 * x));
}

int main()
{
double x_start = 0.0;
double x_end = 0.85;
double step = 0.05;

cout << "x\ty" << endl;

for (double x = x_start; x <= x_end; x += step)
{
if (x > x_end)
{
cout << "No solution for x = " << x << endl;
} else
{
double y = function(x);
cout << x << "\t" << y << endl;
}
}

return 0;
} 
