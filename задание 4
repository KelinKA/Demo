#include <iostream>
#include <cmath>

using namespace std;

double function(double x)
{
return x - (1/(3 + sin(3.6 * x)));
}
int main()
{
double x_start, x_end;
double step = 0.05;
cout << "Введите начальное значение x (должно быть от 0 до 0,85): ";
cin >> x_start;
cout << "Введите конечное значение x (должно быть между начальным значением и 0,85): ";
cin >> x_end;
if (x_end <= x_start)
{
    cout << "Конечное значение x должно быть больше начального. Пожалуйста, введите корректные значения." << endl;
    return 1;
}
if (x_start < 0 || x_start > 0.85 || x_end < x_start || x_end > 0.85)
{
    cout << "Неверный ввод. Пожалуйста, убедитесь, что начальное и конечное значения x находятся в диапазоне [0, 0,85]" << endl;
    return 1;
}
cout << "x\ty" << endl;
for (double x = x_start; x < x_end + step; x += step)
{
    double y = function(x);
    cout << x << "\t" << y << endl;
}
return 0;
}
